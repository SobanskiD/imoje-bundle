{
    "name": "sobanski/imoje-bundle",
    "description": "Symfony Bundle for imoje payment gateway",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Sobanski\\ImojeBundle\\": "src/",
            "Sobanski\\ImojeBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Dawid Sobanski"
        }
    ],
    "require": {
        "php": ">=8.2",
        "symfony/http-kernel": "^6.4|^7.0",
        "symfony/dependency-injection": "^6.4|^7.0",
        "symfony/config": "^6.4|^7.0",
        "symfony/http-client": "^6.4|^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    }
}
